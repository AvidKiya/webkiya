# TEMPLATE ONLY. Generate secrets locally; never commit .env.local or real values.
# `npm run db:local` creates the local DB and ignored .env.local automatically.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/kiya_dev
TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/kiya_test
# Only demo + true together enable the separate synthetic CUSTOMER login.
# For a future live environment use APP_MODE=live and ALLOW_DEMO_LOGIN=false.
APP_MODE=demo
ALLOW_DEMO_LOGIN=true
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
MFA_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# Leave false unless an ingress you control strips/replaces forwarded IP headers.
TRUST_PROXY=false
# Optional canonical browser origin, e.g. https://kiyaco24.ir; do not set to localhost in public previews.
# NEXT_PUBLIC_SITE_URL=
# KIYA_OWNER_PASSWORD is transient CLI input only, not an app setting.
# SMS/gateway remain unconfigured. Telegram + manual card transfer are configured by OWNER/MFA at /admin/settings.
# Optional server-only fallbacks; use a fresh revoked/replaced token, never a chat-exposed token.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# Telegram worker reads encrypted settings from this same DB and MFA_ENCRYPTION_KEY.
# Internal Node origin only (never used by browser); adjust if backend port differs.
# TELEGRAM_INTERNAL_ORIGIN=http://127.0.0.1:3101

# Optional absolute persistent media directory; default .data/media (ignored).
# MEDIA_ROOT=/ABSOLUTE/PERSISTENT/KIYA_MEDIA

# First install only: operator-configured server env, never public/browser input.
# Enables Telegram from env only when no StoreSettings row overrides it.
# TELEGRAM_LOGIN_ENABLED=false
# First-owner claim still requires matching Telegram private own-contact + no existing OWNER + MFA.
# Do not put any real personal phone in this tracked template. Remove claim env after verified bootstrap.
# KIYA_BOOTSTRAP_OWNER_PHONE=
