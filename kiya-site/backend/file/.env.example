# KIYA template ONLY. Never commit .env or put secrets in NEXT_PUBLIC_*.
# Public URLs do not prove domain ownership or service connectivity.
NODE_ENV=development
DEMO_MODE=true
NEXT_PUBLIC_SITE_URL=https://kiyaco24.ir
DATABASE_URL=
DIRECT_DATABASE_URL=
AUTH_SECRET=
MFA_ENCRYPTION_KEY=
OTP_HASH_PEPPER=
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=
SMS_OTP_TEMPLATE_ID=
PAYMENT_PROVIDER=zarinpal
PAYMENT_MODE=sandbox
ZARINPAL_MERCHANT_ID=
PAYMENT_CALLBACK_URL=https://kiyaco24.ir/api/payments/callback/zarinpal
TELEGRAM_BOT_USERNAME=kiyaco24bot
TELEGRAM_CHANNEL_USERNAME=kiyaco24
# Previously shared token must be revoked. Set NEW token only in secret manager.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_CHANNEL_ID=
TELEGRAM_WEBHOOK_URL=https://kiyaco24.ir/api/webhooks/telegram
INSTAGRAM_USERNAME=kiyaco24
META_ACCOUNT_ID=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
S3_ENDPOINT=
S3_REGION=
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PUBLIC_MEDIA_BASE_URL=
EMAIL_PROVIDER=
EMAIL_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
AI_PROVIDER=
AI_API_KEY=
SENTRY_DSN=
# Runtime parses booleans explicitly: string 'false' must never coerce to true.
FEATURE_WHOLESALE=false
FEATURE_WALLET=false
FEATURE_WHEEL=false
FEATURE_INSTAGRAM_AUTO_PUBLISH=false
FEATURE_RESTRICTED_PRODUCTS=false
