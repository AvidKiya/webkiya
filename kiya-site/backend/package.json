{
  "name": "kiya-rebuild-backend",
  "version": "0.11.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3101",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts *.mjs package.json",
    "db:local": "node scripts/local-db.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:migrate:test": "node scripts/db-migrate.mjs --test",
    "prisma:generate": "node scripts/prisma-wasm.mjs generate",
    "prisma:validate": "node scripts/prisma-wasm.mjs validate",
    "postinstall": "node scripts/prisma-wasm.mjs generate",
    "db:seed": "node scripts/seed.mjs",
    "owner:create": "node scripts/create-owner.mjs",
    "test:backend": "vitest run --config vitest.backend.config.ts",
    "db:test:create": "node scripts/create-test-db.mjs",
    "db:maintenance": "node scripts/db-maintenance.mjs",
    "worker:reservations": "node scripts/reservation-worker.mjs",
    "cf:build": "node scripts/cloudflare/build.mjs",
    "cf:dry-run": "wrangler deploy --dry-run --outdir .data/cloudflare-dry-run && node scripts/cloudflare/artifact-check.mjs",
    "cf:deploy": "wrangler deploy",
    "cf:preview": "wrangler dev --ip 0.0.0.0 --port 8787",
    "cf:check-local": "node scripts/cloudflare/local-check.mjs",
    "worker:telegram": "node scripts/telegram-worker.mjs",
    "worker:telegram:poll": "node scripts/telegram-worker.mjs --poll",
    "telegram:first-install:poll": "node scripts/telegram-first-install.mjs --poll",
    "telegram:first-install:webhook": "node scripts/telegram-first-install.mjs --webhook"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.2.8",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261022.1",
    "@opennextjs/cloudflare": "1.20.13",
    "@playwright/test": "^1.58.2",
    "@sparticuz/chromium": "153.0.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.19.15",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv": "18.0.8",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "jsonc-parser": "^3.3.1",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  },
  "type": "module",
  "overrides": {
    "glob@>=10.2.0 <10.5.0": "10.5.0"
  }
}
