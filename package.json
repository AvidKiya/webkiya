{
  "name": "kiya-store",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts *.mjs package.json",
    "db:local": "node scripts/local-db.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:migrate:test": "node scripts/db-migrate.mjs --test",
    "prisma:generate": "node scripts/prisma-wasm.mjs generate",
    "prisma:validate": "node scripts/prisma-wasm.mjs validate",
    "postinstall": "node scripts/prisma-wasm.mjs generate",
    "db:seed": "node scripts/seed.mjs",
    "owner:create": "node scripts/create-owner.mjs",
    "test:backend": "vitest run --config vitest.backend.config.ts",
    "db:test:create": "node scripts/create-test-db.mjs",
    "db:maintenance": "node scripts/db-maintenance.mjs"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.2.8",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@sparticuz/chromium": "153.0.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.19.15",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv": "18.0.8",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "5.0.5"
  },
  "type": "module"
}
